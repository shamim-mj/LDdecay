Package: LDdecay
Title: Advanced Tools for Linkage Disequilibrium Decay and Functional Mapping
Version: 0.1.0
Authors@R: c(
    person("Mohammad Jan", "Shamim", email = "your.email@example.com", role = c("aut", "cre")),
